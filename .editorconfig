# 统一编辑器行为（https://editorconfig.org）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{js,json,html,css}]
indent_size = 2

# Windows 脚本使用 CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf